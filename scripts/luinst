#!/bin/bash
# luinst — landry-ui install
#
# Fetch a landry-ui component into the current project.
#
# Usage:
#   ./luinst audiobook/vanilla player/
#   ./luinst audiobook/react src/components/audiobook/
#   ./luinst serve tools/
#
# Args:
#   $1 — component path in landry-ui (e.g. audiobook/vanilla)
#   $2 — local destination directory (created if needed)
#
# Environment:
#   LANDRY_UI_REPO   — override repo URL (default: https://github.com/hotpocket/landry-ui.git; use git@github.com:hotpocket/landry-ui.git for SSH)
#   LANDRY_UI_BRANCH — override branch (default: main)
set -euo pipefail

REPO="${LANDRY_UI_REPO:-https://github.com/hotpocket/landry-ui.git}"
BRANCH="${LANDRY_UI_BRANCH:-main}"

COMPONENT="${1:?Usage: luinst <component-path> <dest-dir>}"
DEST="${2:?Usage: luinst <component-path> <dest-dir>}"

echo "luinst: ${COMPONENT} → ${DEST} (${BRANCH})"

TMPDIR=$(mktemp -d)
trap "rm -rf '$TMPDIR'" EXIT

git clone --depth 1 --branch "$BRANCH" --single-branch --quiet "$REPO" "$TMPDIR"

if [ ! -d "$TMPDIR/$COMPONENT" ]; then
  echo "Error: ${COMPONENT} not found in repo" >&2
  exit 1
fi

rm -rf "$DEST"
mkdir -p "$DEST"
cp -r "$TMPDIR/$COMPONENT"/* "$DEST"/

echo "Installed:"
ls -1 "$DEST"
