{
  "name": "landry-ui-sso-gate",
  "private": true,
  "description": "Dev/test harness for sso-gate/server, sso-gate/cdk and sso-gate/js. Consumers never install this package: they vendor the parts with luinst and supply the peer libraries themselves.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.cdk.json",
    "test": "node --import tsx --test --test-timeout=15000 test/*.test.ts"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/supertest": "^7.2.0",
    "aws-cdk-lib": "^2.150.0",
    "aws-jwt-verify": "^5.2.1",
    "constructs": "^10.3.0",
    "express": "^4.19.2",
    "supertest": "^7.2.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
